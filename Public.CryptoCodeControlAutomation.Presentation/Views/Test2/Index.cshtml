@{
    ViewData["Title"] = "Moxa TCP Testi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header border-bottom">
        <h4 class="card-title mb-1">Moxa TCP Dinleme Testi</h4>
        <p class="text-muted mb-0">
            Dinleyiciyi başlattıktan sonra Moxa TCP Client hedefini panel PC IP adresi ve seçilen port olarak ayarlayın.
        </p>
    </div>

    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="moxa-listen-port">Dinlenecek Port</label>
                <input id="moxa-listen-port"
                       type="number"
                       min="1"
                       max="65535"
                       value="5001"
                       class="form-control form-control-lg" />
            </div>
            <div class="col-md-4">
                <button id="moxa-start-btn" type="button" class="btn btn-primary btn-lg w-100">
                    Dinlemeyi Başlat
                </button>
            </div>
            <div class="col-md-4">
                <button id="moxa-stop-btn" type="button" class="btn btn-outline-danger btn-lg w-100">
                    Dinlemeyi Durdur
                </button>
            </div>
        </div>

        <div class="mt-3">
            <span class="text-muted me-2">TCP durumu:</span>
            <span id="moxa-listener-status" class="badge bg-secondary">Kontrol ediliyor</span>
            <span class="text-muted ms-4 me-2">Arayüz bağlantısı:</span>
            <span id="moxa-stream-status" class="badge bg-secondary">Bağlanıyor</span>
        </div>

        <hr class="my-4" />

        <div>
            <label class="form-label" for="moxa-code-input">Moxa'dan Gelen Son Veri</label>
            <input id="moxa-code-input"
                   class="form-control form-control-lg"
                   placeholder="TCP portundan veri bekleniyor..."
                   readonly />
            <div id="moxa-code-meta" class="form-text"></div>
        </div>

        <div class="row g-3 align-items-end mt-2">
            <div class="col-md-8">
                <label class="form-label" for="moxa-test-value">Arayüz Aktarım Testi</label>
                <input id="moxa-test-value"
                       class="form-control"
                       value="TEST-KOD-001"
                       placeholder="Moxa olmadan arayüz kanalını test edin" />
            </div>
            <div class="col-md-4">
                <button id="moxa-test-send-btn" type="button" class="btn btn-outline-primary w-100">
                    Test Verisi Gönder
                </button>
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">Gelen Veriler</h6>
                <span id="moxa-message-count" class="badge bg-primary">0</span>
            </div>
            <div class="table-responsive" style="max-height: 360px;">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Veri</th>
                            <th>Kaynak</th>
                            <th>Alınma Zamanı</th>
                        </tr>
                    </thead>
                    <tbody id="moxa-message-table-body">
                        <tr class="text-muted">
                            <td colspan="3">Henüz veri alınmadı.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/test2.js"></script>
}
