@{
    ViewData["Title"] = "Recover";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .scan-input {
            font-size: 1.1rem;
            letter-spacing: 0.3px;
        }
    </style>
}

<div class="card">
    <div class="card-header border-bottom">
        <h4 class="card-title">Üretime Kazandır</h4>
        <p class="text-muted mb-0">Kameranın okuyamadığı ancak sağlam olan ürünleri el terminali ile tekrar sisteme kazandırın.</p>
    </div>

    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="recover-planned-order-no">Planlı Sipariş No</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bx bx-link-alt"></i></span>
                    <input id="recover-planned-order-no" class="form-control scan-input" placeholder="Planlı sipariş numarasını okutun" autocomplete="off" inputmode="text" />
                </div>
            </div> 
            <div class="col-md-6">
                <label class="form-label" for="recover-code-input">Kod</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bx bx-qr-scan"></i></span>
                    <input id="recover-code-input" class="form-control scan-input" placeholder="Kodu okutun" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex justify-content-end align-items-center mb-2">
                <span class="text-muted me-1">Okutulan Kod:</span>
                <span id="recover-code-count" class="badge bg-primary">0</span>
            </div>
            <div class="table-responsive" style="max-height: 360px; overflow: auto;">
                <table id="recover-table" class="table table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th>Kod</th>
                            <th>Tarih</th>
                            <th>Islem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="text-muted">
                            <td colspan="3">Henüz kayıt yok.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button id="recover-submit-btn" class="btn btn-success">Üretime Kazandır</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/recover.js"></script>
}
