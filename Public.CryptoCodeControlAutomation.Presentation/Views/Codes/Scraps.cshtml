@{
    ViewData["Title"] = "Fire Belirleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .scan-input {
            font-size: 1.1rem;
            letter-spacing: 0.3px;
        }

        .scan-help {
            color: #697a8d;
            font-size: 0.9rem;
        }
    </style>
}

<div class="card">
    <div class="card-header border-bottom">
        <h4 class="card-title">
            Fire Belirleme
            <span id="raw-scan-display" class="d-block small text-muted mt-1"></span>
        </h4>
        <p class="scan-help mb-0">Zarar görmüş ama kodların okutabilir durumda olduğu ürünleri el terminali ile fireye ayırın.</p>
    </div>

    <div class="card-body">
        <div class="row g-3 align-items-start">
            <div class="col-md-6">
                <label class="form-label" for="tb-no-input">TB No</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bx bx-barcode"></i></span>
                    <input id="tb-no-input" class="form-control scan-input" placeholder="TB numarasını okutun" autocomplete="off" inputmode="text" />
                </div>
                @* <div class="form-text text-muted">TB okutulduktan sonra Enter otomatik basilir.</div> *@
            </div>
            <div class="col-md-6">
                <label class="form-label" for="planned-order-no">Planlı Sipariş No</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bx bx-link-alt"></i></span>
                    <input id="planned-order-no" class="form-control scan-input" placeholder="Planlı sipariş numarasını okutun" autocomplete="off" inputmode="text" />
                </div>
                <div class="form-text text-muted">TB yoksa planlı sipariş numarasını okutabilirsiniz.</div>
                <div id="planned-order-message" class="form-text" style="min-height: 1.2em;"></div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="scraps-code-input">Kod</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bx bx-qr-scan"></i></span>
                    <input id="scraps-code-input" class="form-control scan-input" placeholder="Kodu okutun" autocomplete="off" />
                </div>
            </div>
            <div class="col-md-4">
                <button id="scraps-add-btn" class="btn btn-primary btn-lg w-100">Ekle</button>
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex justify-content-end align-items-center mb-2">
                <span class="text-muted me-1">Okutulan Kod:</span>
                <span id="scraps-code-count" class="badge bg-primary">0</span>
            </div>
            <div class="table-responsive" style="max-height: 360px; overflow: auto;">
                <table id="scraps-table" class="table table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th>Kod</th>
                            <th>Tarih</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="text-muted">
                            <td colspan="3">Henüz kayıt yok.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button id="scraps-fire-btn" class="btn btn-danger">Fireye Ayır</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/scraps.js"></script>
}
