@{
    ViewData["Title"] = "Kod Sorgulama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .code-lookup-input {
            font-size: 1.1rem;
        }

        .code-lookup-value {
            overflow-wrap: anywhere;
        }

        .code-lookup-card {
            --lookup-accent: #696cff;
            --lookup-soft: rgba(105, 108, 255, .12);
            border: 0;
            border-top: 4px solid var(--lookup-accent);
            box-shadow: 0 .5rem 1.5rem rgba(67, 89, 113, .14);
            overflow: hidden;
        }

        .code-lookup-tone-secondary {
            --lookup-accent: #8592a3;
            --lookup-soft: rgba(133, 146, 163, .14);
        }

        .code-lookup-tone-info {
            --lookup-accent: #03c3ec;
            --lookup-soft: rgba(3, 195, 236, .13);
        }

        .code-lookup-tone-success {
            --lookup-accent: #71dd37;
            --lookup-soft: rgba(113, 221, 55, .14);
        }

        .code-lookup-tone-warning {
            --lookup-accent: #ffab00;
            --lookup-soft: rgba(255, 171, 0, .14);
        }

        .code-lookup-tone-danger {
            --lookup-accent: #ff3e1d;
            --lookup-soft: rgba(255, 62, 29, .13);
        }

        .code-lookup-tone-dark {
            --lookup-accent: #435971;
            --lookup-soft: rgba(67, 89, 113, .13);
        }

        .code-lookup-status {
            padding: 1.5rem;
            background-color: var(--lookup-soft);
        }

        .code-lookup-status-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            flex: 0 0 48px;
            border-radius: 50%;
            background-color: var(--lookup-accent);
            color: #fff;
            font-size: 1.5rem;
        }

        .code-lookup-eyebrow {
            color: var(--bs-secondary-color);
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .code-lookup-status-value {
            color: var(--lookup-accent);
        }

        .code-lookup-package {
            min-width: 116px;
            padding: .65rem 1rem;
            border: 1px solid color-mix(in srgb, var(--lookup-accent) 35%, transparent);
            border-radius: 6px;
            background-color: var(--bs-body-bg);
            text-align: center;
        }

        .code-lookup-package-value {
            color: var(--lookup-accent);
            font-size: 1.35rem;
            font-weight: 700;
        }

        .code-lookup-code {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.1rem;
            border: 1px solid var(--bs-border-color);
            border-left: 4px solid var(--lookup-accent);
            border-radius: 6px;
            background-color: var(--bs-gray-100);
        }

        .code-lookup-code-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            border-radius: 6px;
            background-color: var(--lookup-soft);
            color: var(--lookup-accent);
            font-size: 1.4rem;
        }

        .code-lookup-section + .code-lookup-section {
            padding-top: 1.5rem;
            margin-top: 1.5rem;
            border-top: 1px solid var(--bs-border-color);
        }

        .code-lookup-section-title {
            display: flex;
            align-items: center;
            gap: .65rem;
            margin-bottom: .75rem;
            color: var(--bs-heading-color);
            font-size: .95rem;
            font-weight: 700;
        }

        .code-lookup-section-title i {
            color: var(--lookup-accent);
            font-size: 1.25rem;
        }

        .code-lookup-detail {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-height: 72px;
            padding: .65rem 0;
        }

        .code-lookup-detail-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            border-radius: 6px;
            font-size: 1.1rem;
        }

        .code-lookup-detail-label {
            display: block;
            margin-bottom: .35rem;
            color: var(--bs-secondary-color);
            font-size: .75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .code-lookup-detail-value {
            color: var(--bs-body-color);
            font-weight: 600;
        }

        @@media (max-width: 575.98px) {
            .code-lookup-status {
                padding: 1.1rem;
            }

            .code-lookup-package {
                width: 100%;
                text-align: left;
            }

            .code-lookup-code {
                align-items: flex-start;
            }
        }
    </style>
}

<div class="card mb-4">
    <div class="card-header border-bottom">
        <h4 class="card-title mb-1">Kod Sorgulama</h4>
        <p class="text-muted mb-0">Kripto kodu okutarak mevcut bilgilerini görüntüleyin.</p>
    </div>

    <div class="card-body">
        <form id="code-lookup-form" class="row g-3 align-items-end">
            <div class="col-lg-10">
                <label class="form-label" for="code-lookup-input">Kod</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bx bx-qr-scan"></i></span>
                    <input id="code-lookup-input"
                           class="form-control code-lookup-input"
                           placeholder="Kodu okutun"
                           autocomplete="off"
                           autofocus />
                </div>
            </div>
            <div class="col-lg-2">
                <button id="code-lookup-submit" type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bx bx-search me-1"></i>Sorgula
                </button>
            </div>
        </form>
    </div>
</div>

<div id="code-lookup-empty" class="text-center text-muted py-5">
    <i class="bx bx-qr-scan fs-1 d-block mb-2"></i>
    <span>Sorgulamak için bir kod okutun.</span>
</div>

<div id="code-lookup-not-found" class="alert alert-warning mb-0 d-none" role="alert">
    <div class="d-flex align-items-center">
        <i class="bx bx-error-circle fs-3 me-2"></i>
        <div>
            <strong>Kod bulunamadı.</strong>
            <div class="small">Okutulan kod sistemde kayıtlı değil.</div>
        </div>
    </div>
</div>

<div id="code-lookup-result" class="card code-lookup-card code-lookup-tone-primary d-none">
    <div id="code-lookup-status" class="code-lookup-status border-bottom">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="code-lookup-status-icon">
                    <i class="bx bx-check-shield"></i>
                </span>
                <div>
                    <div class="code-lookup-eyebrow">Kod Durumu</div>
                    <div id="lookup-status-label" class="code-lookup-status-value fs-3 fw-bold">-</div>
                </div>
            </div>
            <div class="code-lookup-package">
                <div class="code-lookup-eyebrow">Paketleme Seviyesi</div>
                <div id="lookup-packaging-badge" class="code-lookup-package-value">-</div>
            </div>
        </div>
    </div>

    <div class="card-body p-4">
        <div class="code-lookup-code">
            <span class="code-lookup-code-icon">
                <i class="bx bx-barcode"></i>
            </span>
            <div class="min-w-0">
                <span class="code-lookup-detail-label">Kripto Kod</span>
                <div id="lookup-code" class="code-lookup-value fs-5 fw-semibold">-</div>
            </div>
        </div>

        <section class="code-lookup-section mt-4">
            <div class="code-lookup-section-title">
                <i class="bx bx-receipt"></i>
                <span>Sipariş Bilgileri</span>
            </div>
            <div class="row gx-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-primary"><i class="bx bx-file"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Satış Sipariş No</span>
                            <div id="lookup-sales-order-no" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-info"><i class="bx bx-list-ol"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Kalem Numarası</span>
                            <div id="lookup-sales-item-no" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-warning"><i class="bx bx-package"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Mamül No</span>
                            <div id="lookup-sales-material-no" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-secondary"><i class="bx bx-barcode-reader"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">GTIN</span>
                            <div id="lookup-gtin" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="code-lookup-section">
            <div class="code-lookup-section-title">
                <i class="bx bx-cog"></i>
                <span>Üretim Bilgileri</span>
            </div>
            <div class="row gx-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-primary"><i class="bx bx-clipboard"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Planlı Sipariş No</span>
                            <div id="lookup-planned-order-no" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-success"><i class="bx bx-pulse"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Planlı Sipariş Durumu</span>
                            <div id="lookup-planned-order-status" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-info"><i class="bx bx-layer"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Paketleme Seviyesi</span>
                            <div id="lookup-packaging-level" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-dark"><i class="bx bx-git-branch"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Hat</span>
                            <div id="lookup-line-code" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-warning"><i class="bx bx-calendar-check"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Tasnif Tarihi</span>
                            <div id="lookup-allocated-at" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="code-lookup-detail">
                        <span class="code-lookup-detail-icon bg-label-success"><i class="bx bx-check-circle"></i></span>
                        <div>
                            <span class="code-lookup-detail-label">Üretim Tarihi</span>
                            <div id="lookup-produced-at" class="code-lookup-detail-value">-</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/codeLookup.js"></script>
}
