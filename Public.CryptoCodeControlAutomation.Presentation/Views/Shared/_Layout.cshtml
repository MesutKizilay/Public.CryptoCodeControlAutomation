        document.addEventListener('DOMContentLoaded', function () {
          // aktif path'i normalize et (kökü koru)
          const normalize = (s) => {
            if (!s) return s;
            s = s.trim().toLowerCase();
            if (s === '/') return '/';                  // <-- kök özel durum
            return s.replace(/\/+$/, '');
          };

          const path = normalize(window.location.pathname) || '/';

          const activate = (a) => {
            const li = a.closest('.menu-item');
            if (!li) return;
            li.classList.add('active');

            // ebeveynleri open/active yap
            let parent = li.parentElement;
            while (parent && !parent.classList.contains('menu-inner')) {
              if (parent.classList.contains('menu-sub')) {
                const owner = parent.closest('.menu-item');
                if (owner) {
                  owner.classList.add('open', 'active');
                  const toggle = owner.querySelector(':scope > a.menu-toggle');
                  if (toggle) toggle.setAttribute('aria-expanded', 'true');
                }
              }
              parent = parent.parentElement;
            }
          };

          let matched = false;

          document.querySelectorAll('.menu-inner .menu-item > a.menu-link').forEach(a => {
            const hrefRaw = a.getAttribute('href') || '';
            const href = normalize(hrefRaw);
            const extras = (a.dataset.activeWhen || '')
              .split(',')
              .map(s => s.trim())
              .filter(s => s.length > 0)           // boşları at
              .map(s => s === '/' ? '/' : normalize(s)); // <-- '/' ise koru

            const isJs = !href || href.startsWith('javascript:');

            // eşleşme kuralları
            const exact = !isJs && href && href === path;
            const starts = !isJs && href && href !== '/' && href !== '' && path.startsWith(href);
            const dataMatch = extras.some(v =>
              v === path || (v && v !== '/' && path.startsWith(v))
            );

            if (exact || starts || dataMatch) {
              activate(a);
              matched = true;
            }
          });

          // İsteğe bağlı: kökteyken kimse eşleşmediyse varsayılan aktif
          if (!matched && path === '/') {
            const def = document.querySelector('.menu-inner .menu-item > a.menu-link[data-default-active="true"]');
            if (def) activate(def);
          }
        });

    </script>
    @await RenderSectionAsync("Scripts", false)
